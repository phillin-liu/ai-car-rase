# ===========================================================================
#  ai-car-rase — .gitignore
# ===========================================================================

# --- Python bytecode / caches ----------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.orig
tests/

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
env/
ENV/
.virtualenv/
.python-version

# --- Packaging / build output ----------------------------------------------
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
# Nuitka
*.build/
*.dist/
*.onefile-build/
# PyInstaller
*.spec
# Rust (anticheat)
anticheat/target/
# Arch Linux packaging: the config folder (arch/aur/) is tracked, the
# compiled package, makepkg scratch dirs and the generated .SRCINFO are not.
*.pkg.tar
*.pkg.tar.*
arch/aur/pkg/
arch/aur/src/
arch/aur/*.tar.gz
arch/aur/.SRCINFO
# Nuitka packaging: compiled dist + generated makepkg source are not tracked.
arch/nuitka/pkg/
arch/nuitka/src/
arch/nuitka/*.tar.zst
arch/nuitka/*.tar.gz
arch/nuitka/.SRCINFO

# --- Test / type-checker caches --------------------------------------------
.pytest_cache/
.pytest_cache*
.mypy_cache/
.pytype/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# --- Editors / OS ----------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# --- Secrets / local config -------------------------------------------------
.env
.env.*
config/keys.json
config/settings.json

# --- Runtime / generated data (kept next to the app, never committed) -------
runtime/
projects/
export/
logs/
*.tmp
*.bak

# --- Generated reports / renders -------------------------------------------
*.pdf
*.log

# --- Ad-hoc debug / tuning scripts and screenshots --------------------------
_test_*.py
_debug*.py
_tune*.py
_obsdbg*.py
_prof.py
_gltest.py
_shot*.png
_ui_*.png
_pdf_page*.png
